# Variables de entorno de DESARROLLO de Senda (TRD §4.4).
# Uso: cp .env.example .env   (el .env no se versiona)
# Si no creás el .env, docker-compose.yml usa estos mismos valores por defecto.

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=senda
POSTGRES_PASSWORD=senda
POSTGRES_DB=senda
# Puerto publicado en tu máquina (cambialo si el 5432 está ocupado)
POSTGRES_PORT=5432

# ── Backend (FastAPI) ─────────────────────────────────────────
# Adentro de Compose el host de la base es "postgres". Si cambiás usuario o clave arriba, cambialos acá también.
DATABASE_URL=postgresql+psycopg://senda:senda@postgres:5432/senda
BACKEND_PORT=8000
# true = catálogo con cursos de ejemplo · false = catálogo vacío
SEED_DEMO=true

# ── Frontend (Vite) ───────────────────────────────────────────
FRONTEND_PORT=5173
# Base de la API que usa el frontend (pasa por el proxy de Vite)
VITE_API_BASE_URL=/api/v1

# ── Se usan a partir de M1 (identidad) — todavía no las lee nadie ──
JWT_SECRET=dev-cambiar-en-serio
JWT_EXPIRES_MINUTES=60
FRONTEND_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="Senda <no-reply@senda.local>"
RESET_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=5/minute
RECOVERY_RATE_LIMIT=3/15minutes
ADMIN_EMAIL=admin@senda.local
ADMIN_PASSWORD=Admin1234
ADMIN_NOMBRE="Moderación Senda"
